{
  "name": "kravv-ient-v3-local",
  "private": true,
  "scripts": {
    "setup": "npm --prefix ient-src ci",
    "dev": "npm --prefix ient-src run dev --",
    "typecheck": "node ient-src/node_modules/typescript/bin/tsc --noEmit --incremental false --project ient-src/tsconfig.json",
    "lint": "npm --prefix ient-src run lint",
    "build": "npm --prefix ient-src run build"
  }
}
